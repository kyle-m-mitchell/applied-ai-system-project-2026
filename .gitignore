# Byte compiled
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
.venv-ml/
env/
venv/

# Large/local FMA build inputs and outputs. The verified 300-track lite artifact
# under data/catalogs is intentionally committed; full/model artifacts ship via
# checksummed releases or stay in the local build workspace.
build/
artifacts/
data/catalogs/fma-full*
data/catalogs/release-cache/

# Secrets — never commit real API keys
.env
.streamlit/secrets.toml

# Evaluation: commit the accepted baseline, ignore the transient latest run
eval/results/latest.json
eval/results/latest.md

# Local UI/session artifacts
.streamlit/credentials.toml

# Observability: opt-in privacy-safe event receipts are local-only
logs/

# OS files
.DS_Store

# Pytest cache
.pytest_cache/
