%% AI Music Companion — TARGET / ROADMAP architecture (includes planned components)
%% This is the intended end state. For what actually exists today, see
%% diagrams/architecture.mmd. Solid arrows = runtime/indexing data flow;
%% dotted arrows = dependency, testing, or observability.
%% Still planned here: Streamlit UI, session-only memory + feedback, and a
%% provider structured-intent parser. (The evaluation report card, the
%% privacy-safe JSONL receipt, and the structured-preference hybrid now exist —
%% see diagrams/architecture.mmd.)

flowchart TB
    subgraph RUNTIME["Runtime request and response"]
        direction LR
        LISTENER(["Listener"])
        APP["Streamlit UI or CLI<br/>RecommendationService + MusicCompanion"]
        INPUT_GUARD["Input + privacy guard<br/>size · PII/secret redaction · injection · crisis safe-response"]
        AGENT["MusicCompanion — bounded agent<br/>intent parser (rule now, provider structured-intent planned)<br/>allowlisted actions + privacy-safe trace"]
        RETRIEVER["Retriever interface<br/>TF-IDF · context guides · Gemini embeddings · hybrid + provenance"]
        RANKER["Hard filters + fusion + MMR diversity<br/>semantic · lexical · structured-preference · session feedback (planned)"]
        EVALUATOR["Grounding evaluator<br/>ids · duplicates · constraints · evidence · count · framing grounding"]
        POLICY["Situation policy<br/>recommend · clarify · no-match · safe-response · degraded"]
        VOICE["Cadence voice<br/>deterministic baseline + optional grounded Gemini framing"]
        OUTPUT_GUARD["Output check<br/>schema · action/hit invariants · framing grounding"]
        RESULT(["Recommendations<br/>songs · reasons · evidence · operating mode"])
        SAFE(["Fixed safe response<br/>crisis · blocked input"])
        FALLBACK["Local degraded mode<br/>TF-IDF retrieval + deterministic voice (no provider)"]

        LISTENER --> APP
        APP --> INPUT_GUARD
        INPUT_GUARD -->|"valid or sanitized (sensitive stays local)"| AGENT
        INPUT_GUARD -->|"crisis / blocked"| SAFE
        AGENT --> RETRIEVER
        RETRIEVER --> RANKER
        RANKER --> EVALUATOR
        EVALUATOR --> POLICY
        POLICY -->|"recommend"| VOICE
        POLICY -->|"no-match / clarify"| RESULT
        VOICE --> OUTPUT_GUARD
        OUTPUT_GUARD --> RESULT
        SAFE --> RESULT
        GEMINI -. "unavailable → local" .-> FALLBACK
        FALLBACK -. "degraded (TF-IDF)" .-> RETRIEVER
    end

    subgraph GROUNDING["Grounding, provider, and session context"]
        direction LR
        CURATOR(["Human curator"])
        SOURCES[("Validated catalog + curated context guides<br/>(+ real-dataset ingestion, planned)")]
        INDEX["Retrieval index<br/>TF-IDF (2 sources) + Gemini embeddings, committed cache<br/>semantic+lexical (+structured) hybrid"]
        MEMORY[("Session-only memory (PLANNED)<br/>preferences · feedback · recent context")]
        GEMINI["Gemini provider adapter (stdlib REST, optional)<br/>embeddings + Cadence framing · structured intent planned<br/>backoff/retry, then local fallback"]

        CURATOR --> SOURCES
        SOURCES --> INDEX
        INDEX --> RETRIEVER
        MEMORY -->|"session context + feedback"| AGENT
        GEMINI -. "AI capability" .-> APP
    end

    subgraph RELIABILITY["Reliability, evaluation, and human review"]
        direction LR
        TESTER(["Human tester"])
        TESTS["pytest + evaluation harness (offline)<br/>labeled normal · edge · adversarial · outage cases"]
        REPORT[("Evaluation report card<br/>quality metrics + pass/fail gate")]
        LOGS[("Privacy-safe JSONL receipt (opt-in)<br/>ids · scores · modes · fingerprints — never query text")]

        TESTER --> TESTS
        TESTS -. "exercises the same service" .-> APP
        TESTS --> REPORT
        APP -. "sanitized events" .-> LOGS
    end

    classDef human fill:#FFF2CC,stroke:#8A6D1D,stroke-width:2px,color:#2D2408;
    classDef interface fill:#DDEBFF,stroke:#315E9E,stroke-width:1.5px,color:#14263F;
    classDef ai fill:#EADFFF,stroke:#7048A8,stroke-width:1.5px,color:#28183D;
    classDef deterministic fill:#DDF4E7,stroke:#327A4D,stroke-width:1.5px,color:#153522;
    classDef data fill:#F3F4F6,stroke:#59636E,stroke-width:1.5px,color:#20252B;
    classDef guard fill:#FFE0E0,stroke:#A33A3A,stroke-width:1.5px,color:#461919;
    classDef test fill:#E0F4F7,stroke:#337783,stroke-width:1.5px,color:#14373D;

    class LISTENER,RESULT,CURATOR,TESTER human;
    class APP interface;
    class AGENT,RETRIEVER,VOICE,GEMINI ai;
    class RANKER,POLICY,FALLBACK,INDEX deterministic;
    class SOURCES,MEMORY,REPORT,LOGS data;
    class INPUT_GUARD,EVALUATOR,SAFE,OUTPUT_GUARD guard;
    class TESTS test;
