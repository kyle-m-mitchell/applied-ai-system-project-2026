%% AI Music Concierge — target architecture
%% Solid arrows = runtime or indexing data flow.
%% Dotted arrows = dependency, testing, or observability.
%% Implemented so far: validated catalog source, local TF-IDF retrieval index,
%% and the Retriever interface. Provider embeddings, context guides, the agent,
%% guards, evaluator, Cadence voice, memory, logs, and report remain planned.

flowchart TB
    subgraph RUNTIME["Runtime request and response"]
        direction LR
        LISTENER(["Listener"])
        APP["Streamlit chat UI or CLI<br/>RecommendationService"]
        INPUT_GUARD["Input + privacy guard<br/>validation · PII · injection"]
        AGENT["Bounded Cadence agent<br/>structured intent + allowlisted plan"]
        RETRIEVER["Retriever interface<br/>local TF-IDF search + provenance (implemented)<br/>provider embeddings planned"]
        RANKER["Hard filters + hybrid ranker<br/>semantic · content · feedback · diversity"]
        EVALUATOR["Runtime evaluator<br/>IDs · constraints · duplicates · evidence"]
        POLICY["Cadence situation policy<br/>recommend · clarify · no-match · degraded"]
        VOICE["Cadence persona renderer<br/>warm fictional DJ · grounded language"]
        OUTPUT_GUARD["Output guard<br/>schema · claims · catalog validation"]
        RESULT(["Recommendations<br/>songs · reasons · evidence · operating mode"])

        SAFE(["Fixed safe response<br/>privacy · high-risk · hard failure"])
        FALLBACK["Deterministic fallback<br/>rule parser · TF-IDF · original scorer"]

        LISTENER --> APP
        APP --> INPUT_GUARD
        INPUT_GUARD -->|"valid request"| AGENT
        AGENT --> RETRIEVER
        RETRIEVER --> RANKER
        RANKER --> EVALUATOR
        EVALUATOR -->|"pass"| POLICY
        POLICY --> VOICE
        VOICE --> OUTPUT_GUARD
        OUTPUT_GUARD --> RESULT

        INPUT_GUARD -->|"blocked or sensitive"| SAFE
        POLICY -->|"safety rule"| SAFE
        AGENT -->|"provider unavailable"| FALLBACK
        EVALUATOR -->|"invalid after one repair"| FALLBACK
        FALLBACK --> POLICY
    end

    subgraph GROUNDING["Grounding, provider, and session context"]
        direction LR
        CURATOR(["Human curator"])
        SOURCES[("Validated 200-song catalog (implemented)<br/>+ curated context guides (planned)")]
        INDEX["Retrieval index<br/>local TF-IDF vectors + content hash (implemented)<br/>provider embeddings planned"]
        MEMORY[("Session-only memory<br/>preferences · feedback · recent context")]
        GEMINI["Gemini provider adapter<br/>structured output · embeddings · grounded language<br/>timeout + one retry"]

        CURATOR --> SOURCES
        SOURCES --> INDEX
        INDEX --> RETRIEVER
        MEMORY -->|"session context + feedback"| AGENT
        GEMINI -. "AI capability" .-> APP
    end

    subgraph RELIABILITY["Reliability, evaluation, and human review"]
        direction LR
        TESTER(["Human tester"])
        TESTS["pytest + evaluation harness<br/>golden normal · edge · adversarial · outage cases"]
        REPORT[("Evaluation report<br/>quality metrics + pass/fail gates")]
        LOGS[("Privacy-safe JSONL logs<br/>steps · tool summaries · validation")]

        TESTER --> TESTS
        TESTS -. "exercises the same service" .-> APP
        TESTS --> REPORT
        APP -. "sanitized events" .-> LOGS
    end

    classDef human fill:#FFF2CC,stroke:#8A6D1D,stroke-width:2px,color:#2D2408;
    classDef interface fill:#DDEBFF,stroke:#315E9E,stroke-width:1.5px,color:#14263F;
    classDef ai fill:#EADFFF,stroke:#7048A8,stroke-width:1.5px,color:#28183D;
    classDef deterministic fill:#DDF4E7,stroke:#327A4D,stroke-width:1.5px,color:#153522;
    classDef data fill:#F3F4F6,stroke:#59636E,stroke-width:1.5px,color:#20252B;
    classDef guard fill:#FFE0E0,stroke:#A33A3A,stroke-width:1.5px,color:#461919;
    classDef test fill:#E0F4F7,stroke:#337783,stroke-width:1.5px,color:#14373D;

    class LISTENER,RESULT,CURATOR,TESTER human;
    class APP interface;
    class AGENT,RETRIEVER,VOICE,GEMINI ai;
    class RANKER,POLICY,FALLBACK,INDEX deterministic;
    class SOURCES,MEMORY,REPORT,LOGS data;
    class INPUT_GUARD,EVALUATOR,SAFE,OUTPUT_GUARD guard;
    class TESTS test;
