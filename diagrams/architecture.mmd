%% AI Music Companion — IMPLEMENTED architecture (what exists and is tested today).
%% For the intended end state (planned UI, session memory, structured ranking),
%% see diagrams/roadmap.mmd. Solid arrows = runtime/indexing data flow;
%% dotted arrows = dependency, testing, or provider capability.

flowchart TB
    subgraph RUNTIME["Runtime request and response (CLI)"]
        direction LR
        LISTENER(["Listener"])
        APP["CLI<br/>RecommendationService + MusicCompanion"]
        INPUT_GUARD["Input + privacy guard<br/>size · PII/secret redaction · injection · crisis safe-response"]
        AGENT["MusicCompanion — bounded agent<br/>rule intent parser + allowlisted actions + privacy-safe trace"]
        RETRIEVER["Retriever interface<br/>TF-IDF · context guides · Gemini embeddings · hybrid + provenance"]
        RANKER["Hard filters + semantic/lexical hybrid + MMR diversity"]
        EVALUATOR["Grounding evaluator<br/>result: ids · duplicates · constraints · evidence · count<br/>generated framing: quoted-title check (narrow, defense-in-depth)"]
        POLICY["Situation policy<br/>recommend · clarify · no-match · safe-response · degraded"]
        VOICE["Cadence voice<br/>deterministic baseline + optional grounded Gemini framing"]
        OUTPUT_GUARD["Output check (contracts + grounding)<br/>schema · action/hit invariants · framing grounding"]
        RESULT(["Recommendations<br/>songs · reasons · evidence · operating mode"])
        SAFE(["Fixed safe response<br/>crisis · blocked input"])
        FALLBACK["Local degraded mode<br/>TF-IDF retrieval + deterministic voice (no provider)"]

        LISTENER --> APP
        APP --> INPUT_GUARD
        INPUT_GUARD -->|"valid or sanitized (sensitive stays local)"| AGENT
        INPUT_GUARD -->|"crisis / blocked"| SAFE
        AGENT --> RETRIEVER
        RETRIEVER --> RANKER
        RANKER --> EVALUATOR
        EVALUATOR --> POLICY
        POLICY -->|"recommend"| VOICE
        POLICY -->|"no-match / clarify"| RESULT
        VOICE --> OUTPUT_GUARD
        OUTPUT_GUARD --> RESULT
        SAFE --> RESULT
        GEMINI -. "unavailable → local" .-> FALLBACK
        FALLBACK -. "degraded (TF-IDF)" .-> RETRIEVER
    end

    subgraph GROUNDING["Grounding and provider"]
        direction LR
        CURATOR(["Human curator"])
        SOURCES[("Validated 200-song catalog<br/>+ curated context guides (query expansion)")]
        INDEX["Retrieval index<br/>TF-IDF (2 sources) + Gemini embeddings, committed cache<br/>semantic+lexical hybrid"]
        GEMINI["Gemini provider adapter (stdlib REST, optional)<br/>embeddings + Cadence framing<br/>one retry, then local fallback"]

        CURATOR --> SOURCES
        SOURCES --> INDEX
        INDEX --> RETRIEVER
        GEMINI -. "AI capability" .-> APP
    end

    subgraph RELIABILITY["Reliability, measurement, and human review"]
        direction LR
        TESTER(["Human tester"])
        TESTS["pytest — 139 offline tests<br/>unit + integration, normal · edge · adversarial · outage"]
        EVAL["Evaluation report card<br/>labeled cases · scenario matrix · pass/fail gate<br/>results never store query text"]
        EVENTS[("Privacy-safe event receipt (opt-in JSONL)<br/>decisions · ids · scores · fingerprints<br/>never query text / prompts / persistent ids")]

        TESTER --> TESTS
        TESTS -. "exercises the same service" .-> APP
        EVAL -. "runs the same public path" .-> APP
        APP -. "one receipt per turn" .-> EVENTS
    end

    classDef human fill:#FFF2CC,stroke:#8A6D1D,stroke-width:2px,color:#2D2408;
    classDef interface fill:#DDEBFF,stroke:#315E9E,stroke-width:1.5px,color:#14263F;
    classDef ai fill:#EADFFF,stroke:#7048A8,stroke-width:1.5px,color:#28183D;
    classDef deterministic fill:#DDF4E7,stroke:#327A4D,stroke-width:1.5px,color:#153522;
    classDef data fill:#F3F4F6,stroke:#59636E,stroke-width:1.5px,color:#20252B;
    classDef guard fill:#FFE0E0,stroke:#A33A3A,stroke-width:1.5px,color:#461919;
    classDef test fill:#E0F4F7,stroke:#337783,stroke-width:1.5px,color:#14373D;

    class LISTENER,RESULT,CURATOR,TESTER human;
    class APP interface;
    class AGENT,RETRIEVER,VOICE,GEMINI ai;
    class RANKER,POLICY,FALLBACK,INDEX deterministic;
    class SOURCES,EVENTS data;
    class INPUT_GUARD,EVALUATOR,SAFE,OUTPUT_GUARD guard;
    class TESTS,EVAL test;
