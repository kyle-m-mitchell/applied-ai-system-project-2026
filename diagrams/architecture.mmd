%% Cadence Phase 5 architecture.
%% Solid arrows are product or build data flow. Dotted arrows are optional,
%% evaluation, or human-governance paths. A built full release asset and promoted
%% feature models remain evidence gates; the code does not invent those results.

flowchart TB
    subgraph OFFLINE["Offline evidence build — never runs in the deployed app"]
        direction LR
        FMAZIP[(Pinned official FMA metadata archive)]
        INTEGRITY["SHA-256 check<br/>safe ZIP validation and extraction"]
        PARSER["Explicit multi-row CSV parser<br/>Unicode and plain-text normalization<br/>safe lists, URLs, and NA policy"]
        SCOPE["Scoped FMA records<br/>track information<br/>album information<br/>artist biography<br/>genres and scoped tags"]
        LIBROSA[(518 Librosa-derived statistics)]
        ECHONEST[(Echo Nest-computed overlap)]
        TRAIN["Offline specialized models<br/>artist-group 70/15/15 split<br/>Dummy and Ridge baselines<br/>HGB point + q10/q90"]
        ABSTAIN["Release and row gates<br/>MAE improvement<br/>interval coverage<br/>OOD and width abstention"]
        MOOD["Experimental mood profile<br/>upbeat · calm · intense · somber<br/>margin below 0.10 = unlabeled"]
        ETL["Evidence-first FMA ETL<br/>valid identity accepted<br/>malformed identity quarantined<br/>unknown remains unknown"]
        FULL[(FMA Full SQLite<br/>all valid source records)]
        LITE[(Committed FMA Lite SQLite<br/>300 deterministic Echo Nest rows)]
        FTS["Normalized tables + FTS5<br/>fixed ordering and serialization"]
        MANIFEST["Checksummed manifest<br/>counts · schema/ETL versions<br/>coverage · licenses · attribution"]
        RELEASE[(Checksummed GitHub Release asset<br/>publication and measurements pending)]

        FMAZIP --> INTEGRITY --> PARSER --> SCOPE --> ETL
        LIBROSA --> TRAIN
        ECHONEST --> TRAIN
        TRAIN --> ABSTAIN --> ETL
        ECHONEST --> ETL
        ETL --> MOOD --> FTS
        ETL --> FTS
        FTS --> FULL
        FTS --> LITE
        FULL --> MANIFEST
        LITE --> MANIFEST
        FULL -. "after measured release gate" .-> RELEASE
    end

    subgraph PRODUCT["Listener request — one bounded MusicCompanion pipeline"]
        direction LR
        HUMAN([Listener])
        SURFACE["Streamlit or CLI<br/>catalog-aware controls and cards"]
        SESSION[(Per-browser session<br/>mix history · undo · ratings<br/>session-learned taste · research cache)]
        GUARD["Input and privacy guard<br/>validation · redaction<br/>injection and crisis routes"]
        INTENT["Typed intent parser<br/>bounded action policy"]
        CAPABILITY["Catalog capability validation<br/>clarify unsupported hard filters"]
        CATALOG_ROUTE{"Catalog route"}
        RESULT_EVAL["Grounding evaluator<br/>known IDs · uniqueness<br/>constraints · used evidence"]
        VOICE["Evidence-bounded Cadence voice<br/>approved framing only"]
        LOCAL_VOICE["Deterministic local generator<br/>provider-free fallback"]
        RESPONSE(["Recommendation, clarification,<br/>no-match, safe, or degraded response"])

        HUMAN --> SURFACE
        SURFACE <--> SESSION
        SURFACE --> GUARD --> INTENT --> CAPABILITY --> CATALOG_ROUTE
        RESULT_EVAL --> VOICE --> RESPONSE --> SURFACE
        LOCAL_VOICE --> VOICE
    end

    subgraph FMA_SERVE["FMA serving path — independent candidate legs"]
        direction LR
        RESOLVER["Artifact resolver<br/>verified local Full → release cache<br/>→ verified bundled Lite"]
        ROSQL[(Read-only, query-only SQLite)]
        TEXT["FTS5 text retriever<br/>top 200<br/>scope-weighted evidence"]
        STRUCT["Structured retriever<br/>top 200<br/>genre and trustworthy numeric axes"]
        RRF["Weighted reciprocal-rank fusion<br/>union of both candidate sets"]
        CONF["Confidence-aware scoring<br/>missing = no reward or penalty<br/>estimate weight follows confidence"]
        MMR["Session-taste re-rank (bounded, session-only)<br/>then MMR diversity<br/>unknown moods never match"]

        RESOLVER --> ROSQL
        ROSQL --> TEXT
        ROSQL --> STRUCT
        TEXT --> RRF
        STRUCT --> RRF
        RRF --> CONF --> MMR --> RESULT_EVAL
    end

    subgraph FICTIONAL["Immutable regression-control path"]
        direction LR
        FCAT[(200-track fictional catalog<br/>authored complete fields)]
        GUIDES[(Versioned context guides)]
        TFIDF["Existing TF-IDF and cached/live<br/>embedding hybrid"]
        FRANK["Existing structured fusion + session-taste re-rank + MMR<br/>text-only ranking behavior preserved"]

        FCAT --> TFIDF
        GUIDES --> TFIDF
        TFIDF --> FRANK --> RESULT_EVAL
    end

    CATALOG_ROUTE -->|FMA| RESOLVER
    CATALOG_ROUTE -->|fictional| TFIDF
    RELEASE -. "verified download only" .-> RESOLVER
    LITE --> RESOLVER
    FULL -. "verified local artifact" .-> RESOLVER

    subgraph RESEARCH["Optional post-ranking research — cannot change the list"]
        direction LR
        RESEARCH_BUTTON(["Human selects Research this track"])
        IDENTITY["MusicBrainz exact identity resolver<br/>title + artist only<br/>User-Agent and rate limit"]
        GROUNDED["Optional Gemini grounded search<br/>resolved identity only<br/>writes a grounded creative narrative"]
        CITATION["Citation and content guard<br/>identity ambiguity · unsafe URL<br/>missing support · injection · size · timeout<br/>narrative withheld if it quotes an unsourced name"]
        BRIEF["Grounded narrative + ≤ 3 cited claims<br/>session-only ResearchBrief · never catalog truth"]
        LOCAL_SUMMARY["Deterministic local FMA summary"]

        SURFACE -.-> RESEARCH_BUTTON --> IDENTITY
        IDENTITY -->|one exact identity| GROUNDED --> CITATION
        CITATION -->|all claims supported| BRIEF --> SURFACE
        IDENTITY -->|none, ambiguous, or unavailable| LOCAL_SUMMARY
        CITATION -->|reject or provider failure| LOCAL_SUMMARY --> SURFACE
    end

    subgraph HUMAN_GATE["Human calibration and isolated benchmark"]
        direction LR
        SAMPLE["Deterministic 300-track sample<br/>prediction fields removed"]
        ANNOTATOR(["Local human annotator<br/>valence · arousal · quadrant · confidence"])
        LABELS[(Local JSONL labels<br/>primary + independent audit)]
        READINESS["Readiness report<br/>300 primary tracks<br/>60 independent audits"]
        PROMOTION{"Human promotion gate<br/>minimum sample and agreement"}
        EXPERIMENTAL["Manifest remains experimental"]
        CALIBRATE["Future bounded calibration<br/>temperature or tag weight only"]
        DEAM[(DEAM local input<br/>CC BY-NC)]
        DEAM_TEST["Explicit non-commercial benchmark<br/>output restricted to eval/noncommercial"]

        SCOPE -.-> SAMPLE --> ANNOTATOR --> LABELS --> READINESS --> PROMOTION
        PROMOTION -->|not met| EXPERIMENTAL
        PROMOTION -. "future: met and reviewed" .-> CALIBRATE
        CALIBRATE -.-> MOOD
        DEAM --> DEAM_TEST
        DEAM_TEST -. "reports only; no production effect" .-> EXPERIMENTAL
    end

    subgraph RELIABILITY["Reliability, observability, and release checking"]
        direction LR
        TESTER([Human tester / reviewer])
        TESTS["Offline pytest suite<br/>contracts · ETL · SQLite · resolver<br/>model gates · mood · research · UI"]
        EVAL["Evaluation harness<br/>fictional control = 0.863<br/>FMA/provenance metrics pending artifacts"]
        PERF["Measured release report<br/>determinism · checksums · p95 latency<br/>open time · memory · size · download"]
        LOG[(Privacy-safe action trace<br/>steps and tool outcomes<br/>never hidden reasoning or prompt text)]

        TESTER --> TESTS
        TESTER --> EVAL
        TESTER --> PERF
        TESTS -.-> OFFLINE
        TESTS -.-> PRODUCT
        EVAL -.-> PRODUCT
        MANIFEST --> PERF
        RESPONSE -.-> LOG
        BRIEF -.-> LOG
    end

    classDef human fill:#FFF2CC,stroke:#8A6D1D,stroke-width:2px,color:#2D2408;
    classDef interface fill:#DDEBFF,stroke:#315E9E,stroke-width:1.5px,color:#14263F;
    classDef ai fill:#EADFFF,stroke:#7048A8,stroke-width:1.5px,color:#28183D;
    classDef deterministic fill:#DDF4E7,stroke:#327A4D,stroke-width:1.5px,color:#153522;
    classDef data fill:#F3F4F6,stroke:#59636E,stroke-width:1.5px,color:#20252B;
    classDef guard fill:#FFE0E0,stroke:#A33A3A,stroke-width:1.5px,color:#461919;
    classDef test fill:#E0F4F7,stroke:#337783,stroke-width:1.5px,color:#14373D;

    class HUMAN,RESEARCH_BUTTON,ANNOTATOR,TESTER human;
    class SURFACE,RESPONSE,CAPABILITY interface;
    class TRAIN,VOICE,GROUNDED ai;
    class PARSER,ETL,MOOD,RESOLVER,TEXT,STRUCT,RRF,CONF,MMR,TFIDF,FRANK,LOCAL_VOICE,IDENTITY,LOCAL_SUMMARY,SAMPLE,READINESS deterministic;
    class FMAZIP,LIBROSA,ECHONEST,FULL,LITE,MANIFEST,RELEASE,ROSQL,FCAT,GUIDES,SESSION,BRIEF,LABELS,DEAM,LOG data;
    class INTEGRITY,ABSTAIN,GUARD,INTENT,RESULT_EVAL,CITATION,PROMOTION,EXPERIMENTAL guard;
    class TESTS,EVAL,PERF,DEAM_TEST,CALIBRATE test;
