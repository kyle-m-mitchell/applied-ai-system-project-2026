# Copy this file to `.env` (which is git-ignored) and paste your Gemini API key.
# Get a key from Google AI Studio. NEVER commit a real key or paste it into chat.
# The app and tests run fully without a key. A key enables live query embeddings,
# embedding-cache builds, and optional approved Cadence-line selection. Local-only and
# sensitive routing still prevent provider calls.
GEMINI_API_KEY=your-rotated-key-here

# Optional operational kill switch. Useful for an offline/staging deployment or
# an automated test process that must not even construct provider clients.
# CADENCE_DISABLE_PROVIDER=1
