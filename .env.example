# Copy this file to `.env` (which is git-ignored) and paste your Gemini API key.
# Get a key from Google AI Studio. NEVER commit a real key or paste it into chat.
# The app and tests run fully without a key; the key only enables the real
# semantic-embedding path (scripts/build_embeddings.py and live query embedding).
GEMINI_API_KEY=your-rotated-key-here
