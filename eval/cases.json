{
  "_about": "Labeled evaluation cases. category = required_now (current promises), planned (future behavior that may fail now), development (inspectable while tuning), holdout (frozen; do not inspect until final eval). Queries are test inputs; results never store them.",
  "cases": [
    {
      "id": "clean_instrumental_lofi",
      "category": "required_now",
      "query": "clean instrumental lofi for studying",
      "expect": {"action": "recommend", "guard_category": "ok", "instrumental_only": true, "exclude_explicit": true, "min_hits": 1, "genres_any": ["lofi", "ambient"]}
    },
    {
      "id": "jazz",
      "category": "required_now",
      "query": "some jazz please",
      "expect": {"action": "recommend", "guard_category": "ok", "min_hits": 1, "genres_any": ["jazz"]}
    },
    {
      "id": "concentrate",
      "category": "required_now",
      "query": "music to concentrate",
      "expect": {"action": "recommend", "guard_category": "ok", "min_hits": 1, "genres_any": ["lofi", "ambient"]}
    },
    {
      "id": "workout",
      "category": "required_now",
      "query": "high energy workout",
      "expect": {"action": "recommend", "guard_category": "ok", "min_hits": 1}
    },
    {
      "id": "gibberish_best_effort",
      "category": "required_now",
      "query": "xyzzy zzz qqq",
      "expect": {"action": "recommend", "min_hits": 1}
    },
    {
      "id": "pii_local",
      "category": "required_now",
