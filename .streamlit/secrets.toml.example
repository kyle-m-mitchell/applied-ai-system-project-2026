# Optional live-Gemini configuration for the Streamlit UI.
#
# Cadence runs fully offline without this file — the committed embedding cache and
# local TF-IDF fallback always work, and "Local-only" mode blocks provider calls
# entirely. Provide a key only if you want live semantic/microcopy on non-local turns.
#
# Local:  copy this file to `.streamlit/secrets.toml` (git-ignored) and fill it in.
# Cloud:  paste the same key into Streamlit Community Cloud → App → Settings → Secrets.
#
# Never commit a real key.
GEMINI_API_KEY = "your-gemini-api-key-here"
